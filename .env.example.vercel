# Vercel + Neon Environment Variables
# Copy these to your Vercel project settings

NODE_ENV=production

# Neon PostgreSQL connection string
# Get from: Neon dashboard > Connection string > PostgreSQL
# Format: postgres://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgres://user:password@ep-xxxxx.us-east-2.aws.neon.tech/supaclean?sslmode=require

# Secret for session tokens (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-jwt-secret-here

# Client uses relative URL on Vercel (same origin)
REACT_APP_API_URL=/api

# Optional: CORS origin (your Vercel deployment URL)
CLIENT_URL=https://your-project.vercel.app

# Optional: SMS (Africa's Talking)
# SMS_API_KEY=
# SMS_USERNAME=
